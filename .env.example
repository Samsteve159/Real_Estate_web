# Copy to .env at the REPO ROOT and fill in. Never commit .env (it is gitignored).
# The Hono API loads this file via api/src/anthropic.ts (dotenv) from the repo root — NOT api/.env.

# Anthropic key that powers Instant Valuation + the AI Concierge (server-side only; never in the browser bundle).
# Use the "Manifest Real Estate" WORKSPACE key (Console -> Workspaces -> Manifest Real Estate -> API keys)
# so all spend attributes to that workspace for per-project invoicing of Akshay.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the default port for the Hono API (default 8787)
PORT=8787

# Optional (prod/deploy): comma-separated origins allowed to call the API
ALLOWED_ORIGINS=

# Optional: bearer token guarding the /stats endpoint
STATS_TOKEN=

# Vault RE (MRI) — live listings + the listing-detail page. Both required; the
# API key alone returns 401. Absent = the site falls back to mock listings.
# Docs: docs.api.vaultre.com.au. See CLAUDE.md "Vault RE integration" for how
# these were obtained.
VAULT_API_KEY=
VAULT_ACCESS_TOKEN=
VAULT_API_BASE_URL=https://ap-southeast-2.api.vaultre.com.au/api/v1.3
VAULT_INTEGRATION_NAME=
VAULT_OFFICE_NAME=

# Enquiry notification email (Resend — free tier, 3,000/mo). Absent = leads
# still save to the database, just nobody is emailed. Sign up at resend.com.
RESEND_API_KEY=
# Where new enquiries should land.
LEADS_NOTIFY_EMAIL=admin@manifestre.com.au
# Sender. Must be an address on a Resend-verified domain — the shared
# onboarding@resend.dev fallback only delivers to the account's own address.
# manifestre.com.au was verified 2026-08-05 (DNS at GoDaddy).
MAIL_FROM=Manifest Real Estate <enquiries@manifestre.com.au>
